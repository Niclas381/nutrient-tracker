{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "result.schema.json",
  "title": "Result written by the routine to outbox/<request_id>.json",
  "type": "object",
  "required": [
    "request_id",
    "type",
    "db_version",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "type": {
      "enum": [
        "log_text",
        "log_photo",
        "enrich_food",
        "ping"
      ]
    },
    "db_version": {
      "type": "string",
      "description": "db_version from db/nutrients.sqlite (table meta) that was used."
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "error_message": {
      "type": "string"
    },
    "result": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error_message"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          },
          "type": {
            "enum": [
              "log_text",
              "log_photo"
            ]
          }
        }
      },
      "then": {
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "$ref": "#/definitions/log_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          },
          "type": {
            "const": "enrich_food"
          }
        }
      },
      "then": {
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "$ref": "#/definitions/enrich_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          },
          "type": {
            "const": "ping"
          }
        }
      },
      "then": {
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "object",
            "required": [
              "ok"
            ],
            "properties": {
              "ok": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "nutrient_amount": {
      "type": "object",
      "required": [
        "code",
        "amount"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "amount": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "log_result": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/log_item"
          }
        },
        "note": {
          "type": "string",
          "description": "Short note shown to the user, e.g. when nothing edible was recognised."
        }
      }
    },
    "log_item": {
      "type": "object",
      "required": [
        "label",
        "amount",
        "unit",
        "confidence"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "food_id"
          ]
        },
        {
          "required": [
            "new_food"
          ]
        }
      ],
      "properties": {
        "label": {
          "type": "string",
          "description": "What was recognised, in the user's words (e.g. 'small rice')."
        },
        "food_id": {
          "type": "integer",
          "description": "A real id from db/nutrients.sqlite (tools/search_food.py)."
        },
        "new_food": {
          "$ref": "#/definitions/new_food"
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "In 'unit'."
        },
        "unit": {
          "enum": [
            "g",
            "ml",
            "piece"
          ],
          "description": "piece only for supplements."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "new_food": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "dish",
            "supplement",
            "food"
          ]
        },
        "ingredients": {
          "type": "array",
          "description": "dish: ingredient breakdown of ONE portion; grams of each ingredient in that portion. Their sum is the portion weight.",
          "items": {
            "type": "object",
            "required": [
              "food_id",
              "grams"
            ],
            "additionalProperties": false,
            "properties": {
              "food_id": {
                "type": "integer"
              },
              "grams": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "nutrients_per_unit": {
          "type": "array",
          "description": "supplement: amounts per 1 piece (tablet, capsule, drop …) from the label/user, units converted (e.g. IU -> µg).",
          "items": {
            "$ref": "#/definitions/nutrient_amount"
          }
        },
        "estimated_nutrients_per_100": {
          "type": "array",
          "description": "food: Claude estimate per 100 g/ml. Only when neither a DB match nor an ingredient breakdown is possible.",
          "items": {
            "$ref": "#/definitions/nutrient_amount"
          }
        },
        "label_nutrients_per_100": {
          "type": "array",
          "description": "food from a nutrition-label photo: values per 100 g/ml exactly as printed on the label (units converted).",
          "items": {
            "$ref": "#/definitions/nutrient_amount"
          }
        },
        "package_amount": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Package size in g/ml when printed on the label."
        }
      }
    },
    "enrich_result": {
      "type": "object",
      "required": [
        "nutrients_per_100"
      ],
      "additionalProperties": false,
      "properties": {
        "matched_food_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "db_match: the generic food the values were copied from."
        },
        "nutrients_per_100": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "amount",
              "origin"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "origin": {
                "enum": [
                  "db",
                  "estimate"
                ]
              }
            }
          }
        },
        "nova_group": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "health_rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "health_reason": {
          "type": "string"
        },
        "nutriscore_inputs": {
          "type": "object",
          "required": [
            "category",
            "fvl_percent"
          ],
          "additionalProperties": false,
          "properties": {
            "category": {
              "enum": [
                "general",
                "beverage",
                "water",
                "fat_oil_nuts_seeds",
                "cheese",
                "red_meat",
                "not_applicable"
              ]
            },
            "fvl_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "non_nutritive_sweeteners": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}